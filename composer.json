{
    "name": "yii2-extensions/debug",
    "type": "yii2-extension",
    "description": "Debug toolbar and debugger panels for Yii2: requests, logs, queries, profiling, timeline, queue, mail, events, asset bundles, and user switching with a Vite-built dependency-free UI.",
    "keywords": [
        "database-profiling",
        "debug",
        "debug-toolbar",
        "debugger",
        "developer-tools",
        "php",
        "profiling",
        "request-inspector",
        "timeline",
        "yii2",
        "yii2-extension"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "composer-runtime-api": "^2.0",
        "php-forge/debug": "^0.4",
        "php-forge/debug-core": "^0.1",
        "symfony/mime": "^7.4",
        "ui-awesome/html": "^0.6",
        "ui-awesome/html-core": "^0.8",
        "ui-awesome/html-core-component": "^0.4",
        "ui-awesome/html-helper": "^0.7",
        "ui-awesome/html-interop": "^0.4",
        "ui-awesome/html-svg": "^0.6",
        "yiisoft/yii2": "^22.0@dev",
        "yiisoft/yii2-symfonymailer": "^22.0@dev",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/coding-standard": "^0.3",
        "php-forge/inertia": "^0.5",
        "php-forge/vite": "^0.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^12.5",
        "xepozz/internal-mocker": "^1.4",
        "yii2-extensions/inertia": "^0.6",
        "yii2-extensions/phpstan": "^0.5"
    },
    "suggest": {
        "php-forge/inertia": "Captures the Inertia protocol result of every request in its own panel. Register its collector and panel under `collectors`/`panels` and hand the collector to the component with `dispatchers`; see docs/configuration.md.",
        "yii2-extensions/inertia": "Provides the `inertia` component that takes the Inertia collector through `dispatchers`; see docs/configuration.md."
    },
    "autoload": {
        "psr-4": {
            "yii\\debug\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii\\debug\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check",
        "codespell": "codespell --config .github/linters/.codespellrc",
        "ecs": "ecs check --fix",
        "ecs-check": "ecs check --ansi",
        "editorconfig-checker": "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
        "gitleaks": "gitleaks git --config .github/linters/.gitleaks.toml --redact",
        "markdownlint": "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md'",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=-1 vendor/bin/infection"
        ],
        "mutation-static": "@mutation --static-analysis-tool=phpstan",
        "prettier": "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}'",
        "quality": [
            "@actionlint",
            "@codespell",
            "@editorconfig-checker",
            "@markdownlint",
            "@prettier",
            "@yamllint"
        ],
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "security": [
            "@zizmor",
            "@gitleaks"
        ],
        "static": "phpstan --memory-limit=-1",
        "tests": "phpunit",
        "yamllint": "yamllint -c .github/linters/.yamllint.yml .github",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "codespell": "Checks spelling with codespell.",
        "ecs": "Applies coding standard fixes with ECS.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "editorconfig-checker": "Checks files against the EditorConfig rules.",
        "gitleaks": "Scans Git history for secrets with Gitleaks.",
        "markdownlint": "Lints Markdown files with markdownlint-cli2.",
        "mutation": "Runs mutation testing with Infection.",
        "mutation-static": "Runs mutation testing with Infection and PHPStan static analysis.",
        "prettier": "Checks Markdown and YAML formatting with Prettier.",
        "quality": "Runs all repository quality checks.",
        "rector": "Applies automated refactoring with Rector.",
        "rector-check": "Previews Rector refactoring without modifying files.",
        "security": "Runs the workflow security and secret scanning checks.",
        "static": "Runs static analysis with PHPStan.",
        "tests": "Runs PHPUnit.",
        "yamllint": "Lints YAML files with yamllint.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    }
}
