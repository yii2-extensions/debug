{
  "name": "@yii2-extensions/debug-assets",
  "private": true,
  "type": "module",
  "description": "Build pipeline for the yii2-extensions/debug client-side assets.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write 'resources/{src,tests}/**/*.js' 'vite.config.js' 'package.json'",
    "format:check": "prettier --check 'resources/{src,tests}/**/*.js' 'vite.config.js' 'package.json'",
    "lint:css": "stylelint --config .github/linters/.stylelintrc.json --config-basedir . 'resources/src/**/*.css'",
    "lint:css:fix": "stylelint --config .github/linters/.stylelintrc.json --config-basedir . --fix 'resources/src/**/*.css'",
    "lint:js": "eslint --config .github/linters/eslint.config.mjs resources",
    "lint:js:fix": "eslint --config .github/linters/eslint.config.mjs --fix resources",
    "test:js": "node --test resources/tests/*.test.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.2.0"
  }
}
